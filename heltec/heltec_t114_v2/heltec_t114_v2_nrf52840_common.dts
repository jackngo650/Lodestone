/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "heltec_t114_v2-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <dt-bindings/lora/sx126x.h>

/ {
	compatible = "others,heltec-t114-v2";
	model = "Heltec T114 v2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,ieee802154 = &ieee802154;
	};

	leds {
		compatible = "gpio-leds";

		led4: led_4 {
			gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};
	};

	board_controls {
		vext_control: vext_control {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "VEXT Control";
		};

		adc_control: adc_control {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "ADC Control";
		};

		tft_en: tft_en {
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			label = "TFT_EN - display enable";
		};

		tft_led_en: tft_led_en {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "TFT_LED_EN - display backlight";
		};

		gnss_rst: gnss_rst {
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			label = "gnss Reset";
		};

		gnss_wakeup: gnss_wakeup {
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			label = "gnss Wake Up";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			label = "Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	gnss_pps {
		gnss_pps_pin: gnss_pps {
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			label = "gnss PPS";
		};
	};

	led_strip: led_strip {
		compatible = "worldsemi,ws2812-gpio";
		label = "SK6812_STRIP";
		gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		chain-length = <2>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		status = "okay";
	};

	aliases {
		led4 = &led4;
		led0 = &led4;
		led-strip = &led_strip;
		button0 = &button0;
		sw0 = &button0;
		mcuboot-led4 = &led4;
		watchdog0 = &wdt0;
		vext-control = &vext_control;
		adc-control = &adc_control;
		tft-en = &tft_en;
		tft-led-en = &tft_led_en;
		gnss-rst = &gnss_rst;
		gnss-wakeup = &gnss_wakeup;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	io-channels = <&adc 2>;
	status = "okay";

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
	};
};

&gpiote {
	status = "okay";
};

&uicr {
	nfct-pins-as-gpios;
	gpio-as-nreset;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&led_strip {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&spi2 {
	compatible = "nordic,nrf-spi";
	pinctrl-0 = <&tft_spi_pins>;
	pinctrl-1 = <&tft_spi_pins_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&spi3 {
	compatible = "nordic,nrf-spim";
	rx-delay-supported;
	rx-delay = <2>;
	pinctrl-0 = <&lora_spi_pins>;
	pinctrl-1 = <&lora_spi_pins_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
	status = "okay";

	lora: sx1262@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <1000000>;
		reset-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
		status = "okay";
	};
};

&uart1 {
	compatible = "nordic,nrf-uarte";
	current-speed = <9600>;
	pinctrl-0 = <&gnss_uart_pins>;
	pinctrl-1 = <&gnss_uart_pins_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	gnss: gnss-nmea-generic {
		compatible = "gnss-nmea-generic";
		status = "okay";
	};
};

zephyr_udc0: &usbd {
	status = "okay";
};
#include <../boards/common/usb/cdc_acm_serial.dtsi>
